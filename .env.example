# Configuración PÚBLICA del navegador. Nunca service_role ni contraseñas.
# Copiar a .env (ignorado por Git); npm run build:config carga .env si existe.
# Netlify: definir las tres variables durante el build; no subir .env.
# DAVID_MODE es explícito: demo para muestras, production para el sitio definitivo.
DAVID_MODE=demo
SUPABASE_URL=
# Admite publishable key y JWT anon tradicional; ambas son públicas.
SUPABASE_PUBLISHABLE_KEY=
