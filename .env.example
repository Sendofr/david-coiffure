# Configuración PÚBLICA del navegador. Nunca service_role ni contraseñas.
# Copiar a .env (ignorado por Git); npm run build:config carga .env si existe.
# Netlify/Vercel: definir estas variables durante el build; no subir .env.
# DAVID_MODE es explícito: demo para muestras, production para el sitio definitivo.
DAVID_MODE=demo
SUPABASE_URL=
# Admite publishable key y JWT anon tradicional; ambas son públicas.
SUPABASE_PUBLISHABLE_KEY=
# Site key PÚBLICA de Cloudflare Turnstile. Sin ella las solicitudes online
# permanecen deshabilitadas; la autenticación y el panel siguen disponibles.
BOOKING_TURNSTILE_SITE_KEY=
# Secretos de Edge (TURNSTILE_SECRET_KEY, BOOKING_RATE_SECRET y la clave
# service_role) se configuran solo en Supabase, nunca en este archivo del sitio.
# BOOKING_ALLOWED_ORIGINS también pertenece a la configuración privada de Edge.
